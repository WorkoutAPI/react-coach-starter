# DEMO uses isolated in-memory fictional data, no database or API key required.
APP_MODE=demo
PORT=3000
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters

# Required when APP_MODE=live. Create this role and database on local PostgreSQL,
# or start the optional Docker service; see docs/REFERENCE.md > PostgreSQL setup.
DATABASE_URL=postgresql://coach:coach@localhost:5432/coach?schema=public
WORKOUTAPI_KEY=
WORKOUTAPI_BASE_URL=https://api.workoutapi.com

# Optional in live mode; required for password recovery, invitations, and notifications.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="React Coach Starter <no-reply@example.test>"
